{
  "name": "pickup-game-manager",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx run-many -t build --all",
    "build:web": "nx build web",
    "build:api": "nx build api",
    "start:api": "nx serve api",
    "start:web": "nx serve web",
    "test": "nx run-many -t test --all --watch=false",
    "test:web": "nx test web --watch=false",
    "test:api": "nx test api --watch=false",
    "lint": "nx run-many -t lint --all",
    "lint:web": "nx lint web",
    "lint:api": "nx lint api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs postgres",
    "migration:run": "npx typeorm migration:run -d apps/api/src/database/data-source.ts",
    "migration:revert": "npx typeorm migration:revert -d apps/api/src/database/data-source.ts",
    "migration:generate": "npx typeorm migration:generate -d apps/api/src/database/data-source.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/platform-browser-dynamic": "~22.2.0",
    "@angular/router": "~22.2.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^12.0.2",
    "axios": "^1.6.0",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "~7.8.0",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.2.0",
    "@angular-devkit/schematics": "~22.2.0",
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@angular/language-service": "~22.2.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "^24.0.0",
    "@nx/eslint": "^24.0.0",
    "@nx/eslint-plugin": "^24.0.0",
    "@nx/jest": "^24.0.0",
    "@nx/js": "24.0.0",
    "@nx/nest": "^24.0.0",
    "@nx/node": "^24.0.0",
    "@nx/web": "24.0.4",
    "@nx/webpack": "24.0.4",
    "@schematics/angular": "~22.2.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/jest": "~30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "~30.3.0",
    "jest-environment-jsdom": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-preset-angular": "~17.0.0",
    "jest-util": "~30.3.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "24.0.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "webpack": "~5.110.0",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "packageManager": "npm@11.12.1",
  "ts-node": {
    "require": ["tsconfig-paths/register"],
    "transpileOnly": true,
    "project": "tsconfig.typeorm.json"
  }
}
